#!/usr/bin/env bash
# SpecCraft Board in one command: starts the board of this project and opens it in the browser.
#
#   .speccraft/board                 start (or reopen, if it is already running) and open the browser
#   .speccraft/board --no-open       start without opening the browser
#   .speccraft/board --read-only     dashboard only, no controls
#   .speccraft/board --port 5000     a fixed port (default: the first free one from 4545)
#   npx speccraft board              the same from any folder of the project (npm package)
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

if [ "${1:-}" = "--install" ]; then
  echo "The \`speccraft\` command comes with the npm package:"
  echo "  npm install -g speccraft      then, in any SpecCraft project: speccraft board"
  echo "Without installing anything:    npx speccraft board"
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "SpecCraft Board needs Node.js 18 or newer: https://nodejs.org (or: brew install node)" >&2
  exit 1
fi
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$NODE_MAJOR" -lt 18 ]; then
  echo "SpecCraft Board needs Node.js 18 or newer (found $(node -v))." >&2
  exit 1
fi

OPEN="--open"
ARGS=()
for arg in "$@"; do
  if [ "$arg" = "--no-open" ]; then OPEN=""; else ARGS+=("$arg"); fi
done
exec node "$DIR/viewer/server.mjs" ${OPEN:+"$OPEN"} ${ARGS[@]+"${ARGS[@]}"}
